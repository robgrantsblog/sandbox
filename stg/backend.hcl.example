# Copy this file into each standalone stack directory as backend.hcl (gitignored).
# Match the bucket from global/bootstrap_s3 and use a unique key per stack.
# S3 native state locking uses the .tflock object in the same bucket.
# Then run from that stack directory:
#   terraform init -backend-config=backend.hcl

bucket         = "CHANGE-ME-tfstate-bucket"
key            = "stg/CHANGE-ME/terraform.tfstate"
region         = "us-east-1"
use_lockfile   = true
encrypt        = true
